+  /**
+   * Pictures in the steps list, only in the wide rail (specs/player-guidance.md G5): each step's resting
+   * picture, drawn in the reader's browser from what the page already carries, so they add no bytes.
+   * One run of the scene per case draws them: it runs undrawn, yields for idle time before every step
+   * and again before drawing the picture the step ends on, never while a step plays or while the rail
+   * is away.
+   * A run cannot start mid-scene, so the pictures come in step order. They are kept per case, and the
+   * others' dropped when the case changes. Decorative (alt=""): each item's words name its step.
+   */
+  let thumbing: Entry | undefined;
+  function idle(): Promise<void> {
+    return new Promise((resolve) => {
+      const check = () => (playing || !railBeside.isConnected ? setTimeout(wait, 250) : resolve());
+      const wait = () => (typeof requestIdleCallback === 'function' ? requestIdleCallback(check) : setTimeout(check, 50));
+      wait();
+    });
+  }
+  function placeThumbs() {
