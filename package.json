{
  "name": "rayner",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && node tools/copy-vendor.ts && node tools/build-cli.ts",
    "test": "node --expose-gc --test test/*.test.ts",
    "test:full": "FULL=1 node --expose-gc --test test/*.test.ts",
    "fonts": "tools/fonts.sh",
    "fonts:lettering": "tools/lettering-fonts.sh",
    "fonts:lettering-outlines": "bash tools/lettering-outline-fonts.sh",
    "check": "tsc -b && node tools/copy-vendor.ts && tsc -p test/consumer/tsconfig.json",
    "prepack": "npm run build:lib",
    "rayner": "node tools/explain.ts",
    "demos:build": "node tools/explain-demos.ts",
    "demos:check": "node tools/explain-demos.ts --check",
    "demos:render": "node tools/explain-demos.ts --render",
    "videos": "node tools/explain-demos.ts --render && EXPLAIN_VIDEO=1 node --test test/explain-video.test.ts && EXPLAIN_VIDEO=1 node tools/explain-package-smoke.ts",
    "demos:serve": "node tools/explain-serve.ts",
    "demos:review": "node tools/explain-review.ts",
    "pack:smoke": "node tools/explain-package-smoke.ts",
    "site:export": "node tools/explain-site.ts",
    "test:embeds": "EXPLAIN_BROWSER=1 node --test test/explain-capture.test.ts test/explain-embed.test.ts test/lettering-browser.test.ts test/lettering-math.test.ts",
    "test:video": "EXPLAIN_VIDEO=1 node --test test/explain-video.test.ts",
    "release:check": "node tools/prepare-release.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "agentic-mermaid": "0.4.1",
    "fast-check": "4.10.2",
    "playwright-core": "1.64.1",
    "shiki": "4.5.0",
    "svgpath": "2.6.0"
  },
  "description": "Step-through explainers from one TypeScript scene, with build-time Agentic Mermaid diagrams and optional captioned video. The browser runtime has no dependencies.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./explain": {
      "types": "./dist/explain/index.d.ts",
      "default": "./dist/explain/index.js"
    },
    "./lettering": {
      "types": "./dist/src/lettering.d.ts",
      "default": "./dist/src/lettering.js"
    }
  },
  "bin": {
    "rayner": "dist/tools/explain.js"
  },
  "author": "Ade Oshineye (https://github.com/adewale)",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "explain",
    "integrations",
    "app/embed*",
    "app/loader.ts",
    "skills",
    "tools/lettering.py",
    "tools/lib/lettering.ts",
    "tools/lib/lettering-validation.ts",
    "vendor/glyph-math.js",
    "vendor/glyph-math.d.ts",
    "tools/lettering-outline-fonts.sh",
    "tools/lettering-requirements.txt",
    "vendor/glyph.js",
    "vendor/glyph.d.ts",
    "vendor/lettering",
    "vendor/licenses",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adewale/rayner.git"
  },
  "keywords": [
    "animation",
    "svg",
    "manim",
    "explainer",
    "stepper",
    "embed",
    "mermaid",
    "video"
  ],
  "dependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "agentic-mermaid": "0.4.1",
    "playwright-core": "^1.64.1",
    "svgpath": "^2.6.0"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "agentic-mermaid": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "svgpath": {
      "optional": true
    }
  },
  "homepage": "https://oshineye.dev/projects/rayner",
  "bugs": {
    "url": "https://github.com/adewale/rayner/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
