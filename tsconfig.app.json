{
  // Browser code: the embed (app/, bundled into each page by `explain build`)
  // and the explainer scenes. Checked only; nothing is emitted.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/app.tsbuildinfo"
  },
  "include": ["app/**/*.ts", "scenes/**/*.ts"]
}
